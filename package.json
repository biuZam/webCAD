{
  "name": "leatherdraft",
  "private": true,
  "version": "0.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "i18n:check": "tsx scripts/check-locales.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm i18n:check --strict",
    "bundle:check": "tsx scripts/check-bundle.ts",
    "mcp:dev": "vite-node --config vite.mcp.config.ts src/mcp/server.ts --",
    "mcp:build": "vite build --config vite.mcp.config.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm i18n:check --strict && pnpm build && pnpm bundle:check && pnpm mcp:build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@salusoft89/planegcs": "^1.3.0",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "clipper-lib": "^6.4.2",
    "happy-dom": "^20.14.6",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.5.0",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "intl-messageformat": "^12.1.3",
    "jspdf": "^4.2.1",
    "makerjs": "^0.19.2",
    "nanoid": "^6.0.2",
    "paper": "^0.12.18",
    "paperjs-offset": "^2.2.1",
    "rbush": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "svg2pdf.js": "^2.8.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^24.13.3",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.11.0"
}
