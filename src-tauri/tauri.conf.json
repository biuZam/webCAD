{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeatherDraft",
  "version": "0.0.0",
  "identifier": "top.igami.leatherdraft",
  "build": {
    "beforeDevCommand": "pnpm dev --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LeatherDraft",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 biuZam",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "shortDescription": "Leather pattern CAD",
    "longDescription": "Draft leather patterns in millimetres and print or cut them at true 1:1 scale.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
